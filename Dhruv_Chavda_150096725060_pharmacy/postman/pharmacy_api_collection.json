{
  "info": {
    "_postman_id": "pharmacy-management-api-v1",
    "name": "Pharmacy & Healthcare Store REST API",
    "description": "Comprehensive Postman collection for Assignment 09 Pharmacy Management & Medicine Ordering REST API demonstrating RBAC across Customer, Pharmacist, and Admin roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "pharmacistToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "medicineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register Pharmacist (Staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Pharmacist\",\n  \"email\": \"pharmacist@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Pharmacist\",\n  \"adminSecretKey\": \"admin_pharmacy_secret_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register-staff",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register-staff"]
            }
          }
        },
        {
          "name": "Register Admin (Staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Super Admin\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Admin\",\n  \"adminSecretKey\": \"admin_pharmacy_secret_2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register-staff",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register-staff"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pharmacist@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Medicines Inventory",
      "item": [
        {
          "name": "List All Medicines (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/medicines?search=Amoxicillin",
              "host": ["{{baseUrl}}"],
              "path": ["medicines"],
              "query": [
                {
                  "key": "search",
                  "value": "Amoxicillin"
                },
                {
                  "key": "category",
                  "value": "Antibiotic",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Add Medicine (Pharmacist/Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin 500mg\",\n  \"brand\": \"GSK\",\n  \"category\": \"Antibiotic\",\n  \"dosageForm\": \"Capsule\",\n  \"price\": 14.50,\n  \"stockQuantity\": 100,\n  \"requiresPrescription\": true,\n  \"expiryDate\": \"2026-10-15T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/medicines",
              "host": ["{{baseUrl}}"],
              "path": ["medicines"]
            }
          }
        },
        {
          "name": "Get Expiring Soon Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines/expiring",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "expiring"]
            }
          }
        },
        {
          "name": "Get Low Stock Medicines",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines/low-stock?threshold=15",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "low-stock"],
              "query": [
                {
                  "key": "threshold",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "Update Medicine (Pharmacist/Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 16.00,\n  \"stockQuantity\": 120\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "{{medicineId}}"]
            }
          }
        },
        {
          "name": "Delete Medicine (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/medicines/{{medicineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "{{medicineId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Orders & Prescriptions",
      "item": [
        {
          "name": "Place Order (Customer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicine\": \"{{medicineId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"prescriptionNotes\": \"Prescription verified by Dr. Smith, ID #RX-9921\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          }
        },
        {
          "name": "Get My Orders (Customer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"]
            }
          }
        },
        {
          "name": "List All Orders (Pharmacist/Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                {
                  "key": "status",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Approve Order & Deduct Stock (Pharmacist/Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reports",
      "item": [
        {
          "name": "Expiring Soon Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/expiring-soon",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "expiring-soon"]
            }
          }
        },
        {
          "name": "Low Stock Report",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/low-stock",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "low-stock"]
            }
          }
        }
      ]
    }
  ]
}
