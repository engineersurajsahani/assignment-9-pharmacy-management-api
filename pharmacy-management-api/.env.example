PORT=5000

# MongoDB Atlas (or local) connection string
MONGO_URI=mongodb://127.0.0.1:27017/pharmacy_management_api

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Used to gate staff self-registration (Pharmacist/Admin) — see /api/auth/register-staff
ADMIN_REGISTRATION_KEY=replace_with_a_secret_only_staff_know
