{
  "info": {
    "name": "Pharmacy Management API - Ashutosh Pawar (150096725130)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom. Login requests save customerToken, pharmacistToken and adminToken. Add Medicine and Place Order save medicineId, rxMedicineId and orderId."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminKey",
      "value": "change_me_staff_key"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "pharmacistToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "medicineId",
      "value": ""
    },
    {
      "key": "rxMedicineId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "soonDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Riya Customer\",\n  \"email\": \"riya@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Register Pharmacist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register-staff",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Pharmacist\",\n  \"email\": \"arjun@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"pharmacist\",\n  \"adminKey\": \"{{adminKey}}\"\n}"
            }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register-staff",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meera Admin\",\n  \"email\": \"meera@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"admin\",\n  \"adminKey\": \"{{adminKey}}\"\n}"
            }
          }
        },
        {
          "name": "Register Staff - wrong key (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register-staff",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fake\",\n  \"email\": \"fake@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"admin\",\n  \"adminKey\": \"wrong\"\n}"
            }
          }
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"riya@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"customerToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Pharmacist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"pharmacistToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meera@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"adminToken\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Profile (customer)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Profile - no token (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Medicines",
      "item": [
        {
          "name": "Add Medicine - customer (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/medicines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Paracetamol\",\n  \"brand\": \"Crocin\",\n  \"category\": \"Analgesic\",\n  \"dosageForm\": \"Tablet\",\n  \"price\": 2.5,\n  \"stockQuantity\": 100,\n  \"expiryDate\": \"2028-12-31\"\n}"
            }
          }
        },
        {
          "name": "Add Medicine - pharmacist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/medicines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Paracetamol\",\n  \"brand\": \"Crocin\",\n  \"category\": \"Analgesic\",\n  \"dosageForm\": \"Tablet\",\n  \"price\": 2.5,\n  \"stockQuantity\": 100,\n  \"expiryDate\": \"2028-12-31\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"medicineId\", pm.response.json().medicine._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add Prescription Medicine - admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/medicines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin\",\n  \"brand\": \"Mox\",\n  \"category\": \"Antibiotic\",\n  \"dosageForm\": \"Capsule\",\n  \"price\": 12,\n  \"stockQuantity\": 8,\n  \"requiresPrescription\": true,\n  \"expiryDate\": \"{{soonDate}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"rxMedicineId\", pm.response.json().medicine._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Browse Medicines",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medicines?search=para"
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medicines?category=Antibiotic"
          }
        },
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medicines/categories"
          }
        },
        {
          "name": "Get Medicine",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medicines/{{medicineId}}"
          }
        },
        {
          "name": "Update Stock and Price - pharmacist",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/medicines/{{medicineId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 3,\n  \"stockQuantity\": 150\n}"
            }
          }
        },
        {
          "name": "Expiring in 30 days - pharmacist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": "{{baseUrl}}/medicines/expiring?days=30"
          }
        },
        {
          "name": "Low Stock - pharmacist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": "{{baseUrl}}/medicines/low-stock?threshold=10"
          }
        },
        {
          "name": "Delete Medicine - pharmacist (403)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": "{{baseUrl}}/medicines/{{medicineId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order - pharmacist (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicine\": \"{{medicineId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Place Order - Rx without notes (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicine\": \"{{rxMedicineId}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Place Order - customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"medicine\": \"{{medicineId}}\",\n      \"quantity\": 10\n    },\n    {\n      \"medicine\": \"{{rxMedicineId}}\",\n      \"quantity\": 2\n    }\n  ],\n  \"prescriptionNotes\": \"Dr. Sharma, 24 Sep 2026\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"orderId\", pm.response.json().order._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My Orders - customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/orders/my-orders"
          }
        },
        {
          "name": "All Orders - customer (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "All Pending Orders - pharmacist",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              }
            ],
            "url": "{{baseUrl}}/orders?status=pending"
          }
        },
        {
          "name": "Approve without prescription check (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            }
          }
        },
        {
          "name": "Approve Order - pharmacist (stock deducted)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"prescriptionVerified\": true\n}"
            }
          }
        },
        {
          "name": "Check stock after approve",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/medicines/{{medicineId}}"
          }
        },
        {
          "name": "Dispense Order - pharmacist",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pharmacistToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"dispensed\"\n}"
            }
          }
        },
        {
          "name": "Get Order - customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Cancel Dispensed Order - customer (400)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Expiring Soon - admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/reports/expiring-soon?days=60"
          }
        },
        {
          "name": "Expiring Soon - customer (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/reports/expiring-soon"
          }
        },
        {
          "name": "Low Stock - admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/reports/low-stock?threshold=20"
          }
        },
        {
          "name": "Orders Summary - admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/reports/orders-summary"
          }
        },
        {
          "name": "Delete Medicine - admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/medicines/{{medicineId}}"
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"soonDate\", new Date(Date.now() + 20 * 864e5).toISOString().slice(0, 10));"
        ]
      }
    }
  ]
}
